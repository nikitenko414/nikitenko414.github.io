<!doctype html>
<html lang="uk">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title | safe }}</title>
<meta name="description" content="{{ description | safe }}">
{% if robotsNoindex %}<meta name="robots" content="noindex">
{% endif %}<link rel="canonical" href="{{ canonical | safe }}">
<meta property="og:title" content="{{ (ogTitle or title) | safe }}">
<meta property="og:description" content="{{ (ogDescription or description) | safe }}">
<meta property="og:type" content="{{ ogType or 'website' }}">
{% if ogUrl %}<meta property="og:url" content="{{ ogUrl | safe }}">
{% endif %}{% if ogImage %}<meta property="og:image" content="{{ ogImage | safe }}">
{% endif %}<link rel="icon" type="image/png" sizes="16x16" href="favicon-16.png">
<link rel="icon" type="image/png" sizes="32x32" href="favicon-32.png">
<link rel="icon" type="image/png" sizes="48x48" href="favicon-48.png">
<link rel="apple-touch-icon" href="apple-touch-icon.png">
<link rel="preload" href="src/fonts/manrope-cyrillic.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="src/fonts/cormorant-garamond-cyrillic-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="src/styles/reset.css">
<link rel="stylesheet" href="src/styles/premium.css">
{% if jsonld %}<script type="application/ld+json">
{{ jsonld | trim | safe }}
</script>
{% endif %}</head>
<body>
<a class="skip-link" href="#top">Перейти до вмісту</a>
<div class="reading-progress" aria-hidden="true"><div class="reading-progress-bar"></div></div>
<header class="site-header">
  <div class="site-header-inner wrap">
    <a class="logo-mark" href="index.html">
      <picture>
        <source type="image/webp" srcset="src/images/logo/entasis-v2-140.webp 140w, src/images/logo/entasis-v2-280.webp 280w" sizes="75px">
        <img src="src/images/logo/entasis-v2-280.png" srcset="src/images/logo/entasis-v2-140.png 140w, src/images/logo/entasis-v2-280.png 280w" sizes="75px" width="280" height="187" alt="Entasis — архітектурна студія" loading="eager">
      </picture>
    </a>
    <nav aria-label="Головна навігація">
      <ul class="nav-list">
        {%- for item in nav %}
        <li><a href="{{ item.href }}"{% if item.key == currentNav %} aria-current="page"{% endif %}>{{ item.label | safe }}</a></li>
        {%- endfor %}
      </ul>
    </nav>
  </div>
</header>

<main id="top" tabindex="-1"{% if hasHero %} class="has-hero-page"{% endif %}>
{{ content | trim | safe }}
</main>

<footer class="site-footer wrap" id="contact">
  <div class="col">
    <h4>ENTASIS</h4>
    <p>Архітектурна студія<br>Київ, Україна</p>
  </div>
  <div class="col">
    <h4>Контакти</h4>
    <a href="mailto:studio@entasis-arch.ua">studio@entasis-arch.ua</a>
    <a href="tel:+380440000000">+380 44 000 00 00</a>
  </div>
  <div class="col">
    <h4>Соцмережі</h4>
    <a href="#">Instagram</a>
    <a href="#">Behance</a>
  </div>
  <div class="col">
    <h4>Категорії</h4>
    <a href="houses.html">Будинки</a>
    <a href="commercial.html">Комерційні приміщення</a>
    <a href="landscape.html">Ландшафтний дизайн</a>
    <a href="interior.html">Інтер'єр</a>
    <a href="blog.html">Блог</a>
  </div>
  <div class="col">
    <h4>Правове</h4>
    <a href="privacy.html">Політика конфіденційності</a>
  </div>
</footer>
<button type="button" class="back-to-top" aria-label="Нагору">↑</button>
{% if extraBodyEnd %}{{ extraBodyEnd | safe }}
{% endif %}<script src="src/scripts/header-scroll.js"></script>
<script src="src/scripts/back-to-top.js"></script>
{% if usesShowcase %}<script src="src/scripts/vendor/gsap.min.js"></script>
<script src="src/scripts/vendor/ScrollTrigger.min.js"></script>
<script src="src/scripts/category-showcase.js?v=cachebust1"></script>
{% endif %}
{% if not noReveal %}<script src="src/scripts/scroll-reveal.js"></script>
<script src="src/scripts/reading-progress.js"></script>
<script src="src/scripts/parallax-hero.js"></script>
{% endif %}</body>
</html>
